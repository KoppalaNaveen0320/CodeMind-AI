# CodeMind AI - Environment Configuration Example
# Duplicate this file as .env in the backend/ directory or root directory:
#   Copy-Item backend/.env.example backend/.env

# Application Configuration
APP_NAME="CodeMind AI"
APP_ENV=development
APP_PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL / SQLAlchemy)
# For local PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/codemind_db
# For SQLite development/testing fallback:
# DATABASE_URL=sqlite:///./codemind_dev.db

# GitHub OAuth / GitHub App Credentials
# Create a GitHub OAuth App or GitHub App at https://github.com/settings/developers
# - Homepage URL: http://localhost:8000
# - Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
# - Scopes required: repo, read:user
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_APP_NAME="CodeMind AI"

# Indexing Resource Boundaries
INDEXING_MAX_FILES=2000
INDEXING_MAX_FILE_SIZE_BYTES=512000
INDEXING_MAX_REPO_SIZE_BYTES=104857600
INDEXING_TIMEOUT_SECONDS=180

# AI Runtime Configuration (Local Ollama default; no API keys required)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local LLM (e.g. qwen2.5:3b, llama3.2:3b, deepseek-coder)
# Ensure model is pulled: ollama pull qwen2.5:3b
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
# For cloud OpenAI mode (optional):
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Local Embeddings (nomic-embed-text outputs 768 dimensions)
# Ensure model is pulled: ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
# For cloud OpenAI mode (optional):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=your_openai_api_key_here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Hybrid Retrieval & Change Impact
RETRIEVAL_TOP_K=8
RETRIEVAL_VECTOR_WEIGHT=0.5
RETRIEVAL_KEYWORD_WEIGHT=0.3
RETRIEVAL_EXACT_WEIGHT=0.2
IMPACT_MAX_DEPTH=3

# Security & Session Authentication
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-key
REQUIRE_AUTH=false

# Rate Limiting & Resource Boundaries
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_INDEXING_PER_MINUTE=10
RATE_LIMIT_ASSISTANT_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_EXTRACTED_SIZE_BYTES=262144000
MAX_ARCHIVE_FILE_COUNT=5000
