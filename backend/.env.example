# CodeMind AI - Environment Configuration Example
# Copy this file to .env in backend/ or root directory:
#   cp backend/.env.example backend/.env   (Linux/macOS)
#   Copy-Item backend/.env.example backend/.env   (Windows PowerShell)

# ==============================================================================
# 1. Application Mode & Server Settings
# ==============================================================================
APP_NAME="CodeMind AI"
# Options: development | production
APP_ENV=development
APP_PORT=8000
# IMPORTANT: In production, DEBUG must be false.
DEBUG=true

# ==============================================================================
# 2. Database Configuration (PostgreSQL with pgvector)
# ==============================================================================
# Connection parameters (used by Docker Compose and auto-assembled into DATABASE_URL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=codemind_db
# Alternatively, full database URL: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:your_strong_postgres_password_here@localhost:5432/codemind_db
# Connection Pool Boundaries
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
# Development SQLite fallback (strictly disabled in production)
ALLOW_SQLITE_FALLBACK=true

# ==============================================================================
# 3. Security, Sessions & Authentication
# ==============================================================================
# In production, SECRET_KEY must be a unique, cryptographically random key of >= 32 characters:
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-key
# In production, set REQUIRE_AUTH=true to enforce authentication on all protected endpoints
REQUIRE_AUTH=false
# Session timeout in minutes (default: 30 minutes, configurable up to 1440)
SESSION_TIMEOUT_MINUTES=30
# Cookie security: true forces Secure attribute (HTTPS only); false for localhost development
SECURE_COOKIES=false
# Trusted reverse proxies for client IP resolution (comma-separated IPs/subnets)
TRUSTED_PROXIES="127.0.0.1,::1,localhost"
# Allowed CORS origins (comma-separated URLs)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# ==============================================================================
# 4. GitHub Integration, Webhooks & Auto-Synchronization
# ==============================================================================
# GitHub OAuth / App credentials from https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_APP_NAME="CodeMind AI"

# GitHub Webhook HMAC secret for verifying /api/v1/webhooks/github push events:
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Background commit polling worker (synchronizes commits without webhooks)
GITHUB_SYNC_POLLING_ENABLED=true
GITHUB_SYNC_POLLING_INTERVAL_SECONDS=300

# AES-256-GCM Token Encryption Key for multi-account GitHub PAT and OAuth credential storage (256-bit URL-safe base64):
# Generate with: python -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM; import base64; print(base64.urlsafe_b64encode(AESGCM.generate_key(256)).decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=

# ==============================================================================
# 5. Local AI Runtime (Ollama - Default, Free, Local)
# ==============================================================================
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local LLM (qwen2.5:3b, llama3.2:3b, deepseek-coder)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90

# Local Vector Embeddings (nomic-embed-text, 768 dimensions)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30

# Cloud OpenAI Mode (Optional Alternative):
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=your_openai_api_key_here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ==============================================================================
# 6. Indexing & Resource Boundaries
# ==============================================================================
INDEXING_MAX_FILES=2000
INDEXING_MAX_FILE_SIZE_BYTES=512000
INDEXING_MAX_REPO_SIZE_BYTES=104857600
INDEXING_TIMEOUT_SECONDS=180

# Chunking & Hybrid Retrieval Tuning
CHUNK_SIZE_LINES=60
CHUNK_OVERLAP_LINES=15
RETRIEVAL_TOP_K=8
RETRIEVAL_VECTOR_WEIGHT=0.5
RETRIEVAL_KEYWORD_WEIGHT=0.3
RETRIEVAL_EXACT_WEIGHT=0.2
IMPACT_MAX_DEPTH=3

# ==============================================================================
# 7. Rate Limiting & Upload Archive Protection
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_INDEXING_PER_MINUTE=10
RATE_LIMIT_ASSISTANT_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Archive Extraction Safety Limits (Zip Bomb & Inode Exhaustion Protection)
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_EXTRACTED_SIZE_BYTES=262144000
MAX_ARCHIVE_FILE_COUNT=5000
